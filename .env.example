# Supabase project (Settings → API). The anon key is public by design;
# data access is controlled by Row Level Security (scripts/create-rls-policies.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin dashboard
ADMIN_PASSWORD=choose-a-long-random-password
# Used to sign the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-random-32-byte-secret
